{
  "expo": {
    "name": "SDA",
    "slug": "sda",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#0c101c",
    "ios": {
      "bundleIdentifier": "app.sda.mobile",
      "infoPlist": {
        "NSMotionUsageDescription": "SDA 使用兼容耳机的头部运动数据控制空间音频方向。",
        "NSLocalNetworkUsageDescription": "开启远程诊断时，SDA 向你指定的局域网接收端发送播放状态和头部姿态。",
        "NSAppTransportSecurity": { "NSAllowsLocalNetworking": true, "NSAllowsArbitraryLoads": true },
        "UIBackgroundModes": [
          "audio"
        ]
      },
      "supportsTablet": true
    },
    "android": {
      "package": "app.sda.mobile"
    },
    "plugins": [
      "./plugins/with-ios-deployment"
    ],
    "scheme": "sda"
  }
}
